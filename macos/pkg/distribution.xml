<?xml version="1.0" encoding="utf-8"?>
<installer-gui-script minSpecVersion="2">
    <title>SpliX for macOS — Samsung printer driver</title>
    <welcome file="welcome.html" mime-type="text/html"/>
    <license file="license.txt" mime-type="text/plain"/>
    <conclusion file="conclusion.html" mime-type="text/html"/>
    <options customize="never" require-scripts="true" rootVolumeOnly="true" hostArchitectures="arm64,x86_64"/>
    <domains enable_localSystem="true"/>
    <volume-check><allowed-os-versions><os-version min="12.0"/></allowed-os-versions></volume-check>
    <choices-outline><line choice="default"><line choice="com.boredjar.splix-macos"/></line></choices-outline>
    <choice id="default"/>
    <choice id="com.boredjar.splix-macos" visible="false"><pkg-ref id="com.boredjar.splix-macos"/></choice>
    <pkg-ref id="com.boredjar.splix-macos" version="__VERSION__" onConclusion="none">SpliX-component.pkg</pkg-ref>
</installer-gui-script>
